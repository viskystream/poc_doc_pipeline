{
    "compilerOptions": {
        "target": "ES2018",
        "module": "commonjs",
        "lib": [
            "ES2020", "DOM",
            "es2018"
        ],
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "outDir": "../dist",
        "rootDir": ".",
        "resolveJsonModule": true,
        "paths": {
        "*": ["../node_modules/*"]
        }
    },
    "include": [
        "./**/*"
    ],
    "exclude": [
        "node_modules",
        "**/*.test.ts"
    ]
}